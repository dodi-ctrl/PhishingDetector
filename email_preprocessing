import re
import string

def preprocess_email(email):
    """
    function to extract features from email

    """
    # Get text
    raw_text = email.get('body', '')
    
    # Remove HTML tags (regex only)
    text = re.sub(r'<[^>]+>', '', raw_text)
    text = text.lower().strip()
    
    # Extract URLs
    urls = re.findall(r'http[s]?://\S+', raw_text)
    
    # Count urgency keywords
    urgency_words = ['urgent', 'immediately', 'verify', 'suspended', 'confirm']
    urgency_count = sum(text.count(word) for word in urgency_words)
    
    # Basic features
    features = {
        'text': text,
        'text_length': len(text),
        'url_count': len(urls),
        'urgency_score': urgency_count,
        'has_ip_url': any(re.search(r'\d+\.\d+\.\d+\.\d+', url) for url in urls),
        'sender': email.get('from', ''),
        'label': email.get('label', None)
    }
    
    return features

